<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Openbox configuration for the kiosk session.

  Deliberately contains no window-management keybinds: no Alt+Tab, no
  Alt+F4, no workspace switching, no root-menu key. The only bindings are
  the hidden admin combo and the media keys.

  The <applications> rule makes every window fullscreen and undecorated so
  ScummVM fills the screen and the admin xterm cannot be moved or resized.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>

  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>

  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>no</keepBorder>
    <animateIconify>no</animateIconify>
  </theme>

  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>kiosk</name>
    </names>
    <popupTime>0</popupTime>
  </desktops>

  <resize>
    <drawContents>no</drawContents>
    <popupShow>Never</popupShow>
  </resize>

  <keyboard>
    <!-- Hidden admin combo: flag the supervisor and stop ScummVM. -->
    <keybind key="C-A-S-F12">
      <action name="Execute">
        <command>/usr/local/bin/kiosk-admin-request.sh</command>
      </action>
    </keybind>

    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>/usr/local/bin/kiosk-volume.sh up</command>
      </action>
    </keybind>

    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>/usr/local/bin/kiosk-volume.sh down</command>
      </action>
    </keybind>

    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>/usr/local/bin/kiosk-volume.sh mute</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <dragThreshold>8</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
  </mouse>

  <applications>
    <application class="*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
